    {
      "op": "assert",
      "target": "battle.info.count.A.A",
      "label": "0"
    },
    {
      "op": "assert",
      "target": "battle.info.count.A.N",
      "label": "0"
    },
    {
      "op": "assert",
      "target": "battle.info.count.B.I",
      "label": "0"
    },
    {
      "op": "assert",
      "target": "battle.info.count.B.G",
      "label": "2"
    },
    {
      "op": "assert",
      "target": "battle.info.count.B.A",
      "label": "0"
    },
    {
      "op": "assert",
      "target": "battle.info.count.B.N",
      "label": "0"
