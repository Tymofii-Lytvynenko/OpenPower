    },
    {
      "op": "click",
      "target": "covert_ops.cell.cell-first.select"
    },
    {
      "op": "assert",
      "target": "covert_ops.selected_cell",
      "label": "MISSION \u00b7 First cell"
    },
    {
      "op": "click",
      "target": "covert_ops.open_new_mission"
    },
    {
