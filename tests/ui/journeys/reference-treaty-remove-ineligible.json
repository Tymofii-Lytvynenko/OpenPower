{
  "fixture": "tests/ui/fixtures/reference-treaty-ineligible.json",
  "steps": [
    {"op": "click", "target": "hud.panel.pol"},
    {"op": "click", "target": "politics.open_treaties"},
    {"op": "assert_region", "target": "treaties.panel", "visible": true},
    {"op": "click", "target": "treaties.active.treaty-ukr-pol-deu"},
    {"op": "click", "target": "treaties.view_selected"},
    {"op": "assert_region", "target": "treaties.details.dialog", "visible": true},
    {"op": "assert", "target": "treaties.details.remove_ineligible", "visible": true, "enabled": true},
    {"op": "assert", "target": "treaties.eligible.UKR", "visible": true},
    {"op": "assert", "target": "treaties.eligible.POL", "visible": true},
    {"op": "assert_absent", "target": "treaties.eligible.DEU"},
    {"op": "click", "target": "treaties.details.remove_ineligible"},
    {"op": "assert_region", "target": "generic_message.dialog", "visible": true},
    {
      "op": "assert",
      "target": "generic_message.content",
      "label": "Treaty eligibility\nRemoved ineligible members from the draft: DEU. Apply the participant changes to save."
    },
    {"op": "click", "target": "generic_message.ok"},
    {"op": "assert_region", "target": "treaty.participants.dialog", "visible": true},
    {"op": "assert_absent", "target": "treaty.participants.side_b.DEU"},
    {"op": "click", "target": "treaty.participants.apply"},
    {
      "op": "assert_action",
      "type": "ActionUpdateTreatyParticipants",
      "fields": {
        "treaty_id": "treaty-ukr-pol-deu",
        "side_a_country_tags": ["UKR"],
        "side_b_country_tags": ["POL"]
      }
    }
  ]
