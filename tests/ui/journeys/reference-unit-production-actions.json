    {"op": "click", "target": "unit_production.select_design.design-infantry-1"},
    {"op": "assert", "target": "unit_production.manpower.value", "visible": true, "label": "20 000 000"},
    {"op": "assert", "target": "unit_production.speed", "visible": true, "enabled": false, "type": "combo"},
    {"op": "click", "target": "unit_production.quantity.up"},
