{
  "fixture": "tests/ui/fixtures/reference-used-unit-market.json",
  "steps": [
    {"op": "click", "target": "hud.panel.mil"},
    {"op": "assert_region", "target": "military.panel", "visible": true},
    {"op": "click", "target": "military.open_market"},
    {
      "op": "assert_region",
      "target": "unit_market.panel",
      "visible": true,
      "min_width": 712,
      "min_height": 472
    },
    {
      "op": "assert_region",
      "target": "unit_market.list",
      "visible": true,
      "relative_to": "unit_market.panel",
      "relative_rect": {"x": 44, "y": 63, "width": 268, "height": 287},
      "tolerance": 0.5
    },
    {
      "op": "assert",
      "target": "unit_market.type",
      "type": "combo",
      "enabled": true,
      "relative_to": "unit_market.panel",
      "relative_rect": {"x": 119, "y": 45, "width": 193, "height": 16},
      "tolerance": 0.5
    },
    {"op": "select", "target": "unit_market.type", "value": "Tank"},
    {"op": "click", "target": "unit_market.listing.listing-pol-tanks"},
    {"op": "assert", "target": "unit_market.unit_price", "type": "input_text", "value": "$ 5 000"},
    {"op": "assert", "target": "unit_market.total_price", "type": "input_text", "value": "$ 240 000"},
    {
      "op": "assert_region",
      "target": "unit_market.capabilities",
      "visible": true,
      "relative_to": "unit_market.panel",
      "relative_rect": {"x": 394, "y": 327, "width": 257, "height": 123},
      "tolerance": 0.5
    },
    {
      "op": "assert",
      "target": "unit_market.quantity.input",
      "type": "input_text",
      "enabled": true,
      "relative_to": "unit_market.panel",
      "relative_rect": {"x": 141, "y": 387, "width": 156, "height": 16},
      "tolerance": 0.5
    },
    {"op": "input", "target": "unit_market.quantity.input", "value": 4},
    {"op": "click", "target": "unit_market.quantity.down"},
    {"op": "assert", "target": "unit_market.total_price", "type": "input_text", "value": "$ 15 000"},
    {
      "op": "assert",
      "target": "unit_market.buy",
      "type": "button",
      "enabled": true,
      "relative_to": "unit_market.panel",
      "relative_rect": {"x": 136, "y": 428, "width": 88, "height": 18},
      "tolerance": 0.5
    },
    {"op": "click", "target": "unit_market.buy"},
    {
      "op": "assert_action",
      "type": "ActionBuyMarketUnit",
      "fields": {
        "listing_id": "listing-pol-tanks",
        "buyer_country_tag": "UKR",
        "quantity": 3
      }
    },
    {"op": "assert", "target": "unit_market.request_status", "visible": true}
  ]
}
